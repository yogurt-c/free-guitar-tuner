# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      if config.name != 'Debug'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
      end
    end
  end

  # Fix objective_c.framework simulator platform tag (arm64 slice built as IOSSIMULATOR)
  user_project = installer.aggregate_targets.first&.user_project
  if user_project
    runner_target = user_project.targets.find { |t| t.name == 'Runner' }
    if runner_target && !runner_target.shell_script_build_phases.any? { |p| p.name == 'Fix Simulator Platform Tags' }
      phase = runner_target.new_shell_script_build_phase('Fix Simulator Platform Tags')
      phase.shell_script = <<~'SCRIPT'
        if [ -z "${EXPANDED_CODE_SIGN_IDENTITY}" ] || [ "${EXPANDED_CODE_SIGN_IDENTITY}" = "-" ]; then
          exit 0
        fi
        find "${CODESIGNING_FOLDER_PATH}/Frameworks" -name "*.framework" -type d 2>/dev/null | while read fw; do
          bin="${fw}/$(basename "${fw}" .framework)"
          if [ -f "${bin}" ] && xcrun vtool -show "${bin}" 2>/dev/null | grep -q "platform IOSSIMULATOR"; then
            minos=$(xcrun vtool -show "${bin}" 2>/dev/null | grep "minos" | head -1 | awk '{print $2}')
            sdk=$(xcrun vtool -show "${bin}" 2>/dev/null | grep "sdk " | head -1 | awk '{print $2}')
            xcrun vtool -set-build-version ios "${minos}" "${sdk}" -replace -output "${bin}" "${bin}"
            codesign --force --sign "${EXPANDED_CODE_SIGN_IDENTITY}" --timestamp=none "${fw}"
            echo "Fixed + re-signed: $(basename ${fw})"
          fi
        done
      SCRIPT
      user_project.save
    end
  end
end
